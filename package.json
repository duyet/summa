{
  "name": "summa",
  "version": "0.1.0",
  "private": true,
  "description": "summa monorepo — CLI (`@summa/cli`) + telemetry API Worker (`@summa/api`)",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bun run build:cli && bun run build:api",
    "build:cli": "bun run --filter @summa/cli build",
    "build:api": "bun run --filter @summa/api build",
    "check": "bun run --filter @summa/cli check && bun run --filter @summa/api check",
    "test": "bun run --filter @summa/cli test && bun run --filter @summa/api test",
    "test:deploy": "bash scripts/ci/validate-deploy.sh",
    "test:ts": "bun test",
    "dev:api": "bun run --filter @summa/api dev",
    "deploy:api": "bun run --filter @summa/api deploy",
    "dev": "bun run src/index.ts",
    "build:ts": "bun build src/cli.ts --outdir ./dist --target bun",
    "build:node": "bun build src/cli.ts --outdir ./dist --target node",
    "test:watch": "bun test --watch",
    "test:bun": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "clean": "rm -rf dist",
    "setup-cronjob": "bun run src/scripts/setup-cronjob.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "ccusage",
    "clickhouse",
    "analytics",
    "cli",
    "typescript"
  ],
  "author": "summa contributors",
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^1.10.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.0.0",
    "duckdb": "^1.4.4",
    "duckdb-async": "^1.4.2",
    "ink": "^7.0.0",
    "ora": "^9.0.0",
    "react": "^19.0.0",
    "react-devtools-core": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyet/summa.git"
  },
  "bugs": {
    "url": "https://github.com/duyet/summa/issues"
  },
  "homepage": "https://github.com/duyet/summa#readme"
}
