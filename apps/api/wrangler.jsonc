{
  "name": "summa-telemetry",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-08-19",
  "observability": { "enabled": true },
  "build": {
    "command": "bash build.sh"
  },
  "routes": [{ "pattern": "summa.duyet.net", "custom_domain": true }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "summa-telemetry",
    "database_id": "02547ac8-2e01-4f9c-b3aa-bb17bf4a841b",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZHV5ZXQubmV0JA"
  }
}
